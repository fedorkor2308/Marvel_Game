<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — MARVEL CARDS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="auth-wrap">
  <div class="auth-box">
    <div class="auth-title">MARVEL CARDS</div>
    <div class="error-msg" id="err"></div>
    <label>Email</label>
    <input type="email" id="email" placeholder="agent@shield.com" autocomplete="off">
    <label>Password</label>
    <input type="password" id="password" placeholder="••••••••">
    <button class="btn-primary" id="login-btn">LOGIN</button>
    <button class="btn-secondary" onclick="location.href='/register'">CREATE ACCOUNT</button>
    <div class="auth-link">No account? <a href="/register">Register here</a></div>
  </div>
</div>
<script src="/js/auth.js"></script>
<script>
  initLogin();
</script>
</body>
</html>
